{
  "manifest_version": 3,
  "name": "报销的自动化：财务接入与填报",
  "version": "0.5.0",
  "key": "",
  "description": "复用当前科大财务会话，按案件参数读取和填写草稿；本人审核和验证码留给用户",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": ["https://cwzh.ustc.edu.cn/*", "http://cwzh.ustc.edu.cn/*", "https://id.ustc.edu.cn/cas/login*"],
  "background": {"service_worker": "native_bridge.js"},
  "action": {
    "default_popup": "popup.html",
    "default_title": "报销助手：检查当前登录"
  }
}
